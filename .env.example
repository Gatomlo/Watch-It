# Copie ce fichier en ".env" puis modifie les valeurs avant de démarrer le serveur.

# Port d'écoute du serveur Node.js (3100 pour ne pas gêner Fée Lezcomptes sur 3000)
PORT=3100

# Chaîne aléatoire et longue utilisée pour signer les sessions.
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Clé qui chiffre la clé API IA enregistrée dans la base (AES-256-GCM).
# Si elle change, la clé IA doit être saisie à nouveau. Même méthode de génération.
SECRETS_KEY=change-this-to-another-long-random-string

# Mets "true" uniquement quand le site est servi en HTTPS (obligatoire en production).
COOKIE_SECURE=false

# Compte créé automatiquement au premier démarrage (si la base est vide).
ADMIN_USERNAME=foyer
ADMIN_PASSWORD=change-me-now

# Dossier de la base SQLite (data/app.db).
DATA_DIR=./data

# --- TMDB (films, séries, affiches, bandes-annonces, plateformes) ---
# Compte gratuit sur https://www.themoviedb.org puis Réglages > API.
# Renseigne l'un des deux : la clé API (v3) ou le jeton d'accès en lecture (v4).
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Région par défaut pour les plateformes (code pays ISO) : BE, FR, CH, LU, CA…
DEFAULT_REGION=BE

# --- Assistant d'envies (facultatif) ---
# La clé API (Claude, Gemini ou Mistral) se saisit dans l'appli : Réglages > Assistant d'envies.
# Modèles utilisés, modifiables ici si besoin :
# AI_MODEL_CLAUDE=claude-haiku-5-5
# AI_MODEL_GEMINI=gemini-2.5-flash
# AI_MODEL_MISTRAL=mistral-small-latest
